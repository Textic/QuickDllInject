// QuickDllInject options dialog resource.

#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_OPTIONS DIALOGEX 0, 0, 288, 254
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Quick DLL Inject"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Injection Method",IDC_STATIC,7,7,274,60
    LTEXT           "Method:",IDC_STATIC,14,22,40,8
    COMBOBOX        IDC_METHOD_COMBO,58,20,216,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_METHOD_DESC,14,38,260,22,SS_LEFT | NOT WS_GROUP
    GROUPBOX        "General",IDC_STATIC,7,71,274,62
    LTEXT           "Timeout (ms):",IDC_STATIC,14,86,55,8
    EDITTEXT        IDC_TIMEOUT_EDIT,73,84,60,14,ES_LEFT | ES_NUMBER | WS_TABSTOP | WS_BORDER
    CONTROL         "",IDC_TIMEOUT_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | WS_GROUP,133,84,11,14
    CONTROL         "Confirm before injecting",IDC_CONFIRM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,102,150,10
    CONTROL         "Show notification on success",IDC_NOTIFY_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,116,160,10
    GROUPBOX        "History",IDC_STATIC,7,137,274,56
    LTEXT           "Maximum entries:",IDC_STATIC,14,152,65,8
    EDITTEXT        IDC_HISTORY_EDIT,83,150,40,14,ES_LEFT | ES_NUMBER | WS_TABSTOP | WS_BORDER
    CONTROL         "",IDC_HISTORY_SPIN,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | WS_GROUP,123,150,11,14
    PUSHBUTTON      "Clear History",IDC_CLEAR_HISTORY,14,168,80,14
    GROUPBOX        "Stealth (opt-in)",IDC_STATIC,7,197,274,50
    CONTROL         "Erase PE headers after load",IDC_ERASE_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,209,160,10
    CONTROL         "Unlink module from PEB lists",IDC_UNLINK_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,221,160,10
    CONTROL         "Hide injection thread from debugger",IDC_HIDETHREAD_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,233,170,10
END

#endif
